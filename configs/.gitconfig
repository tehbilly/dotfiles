[init]
    defaultBranch = main

[user]
    name = {{ user_name }}
    email = {{ user_email }}

[include]
    # Machine-specific overrides (gpg.program, credential helpers, etc.)
    # This file is gitignored and must be created per-machine.
    path = ~/.gitconfig.local

[includeIf "gitdir:~/work/"]
    # Work-specific overrides (user.email, signing key, etc.)
    # Missing files are silently ignored by git.
    path = ~/.gitconfig.work

[alias]
    lg1 = log --graph --abbrev-commit --decorate --date=relative --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
    lg = !"git lg1"
    lc = log ORIG_HEAD.. --stat --no-merges
    diffstat = diff --stat -r
    unstage = reset HEAD --
    last = log -1 HEAD
    amend = commit --amend --no-edit
    wip = !git add -A && git commit -m 'WIP'

{% if core_autocrlf is defined %}
[core]
    autocrlf = {{ core_autocrlf }}
{% endif %}

[push]
    autoSetupRemote = true

[pull]
    rebase = true

[fetch]
    prune = true

[commit]
    gpgsign = true

[tag]
    gpgsign = true

[diff]
    algorithm = histogram

[merge]
    conflictstyle = zdiff3

[rerere]
    enabled = true
